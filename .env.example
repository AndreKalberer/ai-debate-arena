# URL of the backend API — must use HTTPS in production
# Example: VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:5050

# Set to false only for local development — production should use true
VITE_REQUIRE_AUTH=true

# Firebase (required when VITE_REQUIRE_AUTH=true)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
